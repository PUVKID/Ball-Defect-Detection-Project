+        handles.append(h); labels_leg.append(f"Max {mx:.1f}{'%' if '%' in value_fmt else ''}")
+    if show_min:
+        mn = np.nanmin(values)
+        h = ax.axhline(mn, color="#2f9e8f", linestyle="--", linewidth=1.4, zorder=2)
+        handles.append(h); labels_leg.append(f"Min {mn:.1f}{'%' if '%' in value_fmt else ''}")
