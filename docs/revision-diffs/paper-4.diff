+        near = pts[np.argsort(np.hypot(pts[:, 0] - top[0], pts[:, 1] - top[1]))[:5]]
+        cx, cy = near.mean(axis=0)
+    else:
+        cx, cy = W / 2, H / 2
+    x0 = int(np.clip(cx - zw / 2, 0, W - zw))
+    y0 = int(np.clip(cy - zh / 2, 0, H - zh))
+    return (x0 / W, y0 / H, (x0 + zw) / W, (y0 + zh) / H)
