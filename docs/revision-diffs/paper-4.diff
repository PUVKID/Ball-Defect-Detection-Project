+def wilson_ci(k, n, z=1.96):
+    """95% Wilson score interval (in %) for k successes out of n."""
+    if n == 0:
+        return 0.0, 0.0
+    p = k / n
+    d = 1 + z * z / n
+    centre = (p + z * z / (2 * n)) / d
+    half = z * math.sqrt(p * (1 - p) / n + z * z / (4 * n * n)) / d
+    return 100 * (centre - half), 100 * (centre + half)
+
