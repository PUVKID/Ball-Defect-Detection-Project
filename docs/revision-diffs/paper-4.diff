+def _auto_zoom_fractions():
+    """A native-resolution window around the balls: the top-most ball and its 4 nearest neighbours."""
+    H, W = sample_gray.shape
+    zw, zh = min(GRID_ZOOM_PX[0], W), min(GRID_ZOOM_PX[1], H)
