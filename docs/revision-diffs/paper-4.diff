+def _link_or_copy(src, dst):
+    if os.path.lexists(dst):
+        os.remove(dst)
+    try:
+        os.symlink(os.path.abspath(src), dst)
+    except (OSError, NotImplementedError):
+        shutil.copyfile(src, dst)
+
