+              f"rule NG / real OK: {sum(d['real'] == 'OK' for d in _dis)} -> labelling or rectangle problem)")
+        _rows = []
+        for nm, per in PER_IMAGE.items():
+            sub = [r for r in per if r["key"] in REAL_BY_KEY]
