-    "            _cf = _p.boxes.conf.cpu().numpy() if len(_p.boxes) else np.zeros(0)\n",
-    "            _raw.append((it, _xy, _cf))\n",
-    "        _best = (-1.0, CONF_THRES)\n",
-    "        for _c in np.arange(0.10, 0.80, 0.05):\n",
-    "            _hit = {\"OK\": [0, 0], \"NG\": [0, 0]}\n",
-    "            for it, _xy, _cf in _raw:\n",
-    "                _g = gt_by_key[it[\"key\"]]\n",
